{
  "name": "restack",
  "displayName": "Restack",
  "description": "Visualize and rearrange GitHub stacked pull requests by drag and drop.",
  "version": "0.0.1",
  "publisher": "felixzhang",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "restack",
          "title": "Restack",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "restack": [
        {
          "id": "restack.stackView",
          "name": "Stack",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "restack.refresh",
        "title": "Restack: Refresh Stack",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "restack.refresh",
          "when": "view == restack.stackView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Restack",
      "properties": {
        "restack.ghPath": {
          "type": "string",
          "default": "gh",
          "description": "Path to the gh CLI executable."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "vscode:prepublish": "npm run build -- --production"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
