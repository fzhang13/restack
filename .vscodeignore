# Everything is bundled into dist/ by esbuild, so the extension ships as four
# files plus the icon. Without this, vsce walks node_modules and packages ~6 MB
# of dependencies that are already inlined in the bundle.

node_modules/**

.vscode/**
.claude/**
.github/**

src/**
test/**
scripts/**
fixtures/**
sandbox/**
sandbox-conflict/**
sandbox-multi/**

# Sources and build scripts for the marketplace art. media/icon.png and
# media/screenshot.png ship; what generates them does not.
media/marketplace-icon.svg
media/build-*.mjs

esbuild.mjs
tsconfig.json
package-lock.json
.gitignore
.vscodeignore

# Contributor context, not user documentation. README.md and CHANGELOG.md are
# the two that render on the marketplace page and do ship.
CLAUDE.md
docs/**

# Agent working notes. Untracked, so a CI build from a fresh checkout never
# sees them — but `vsce package` walks the working tree, so a local package run
# would otherwise bundle every one. The v0.5.1 failure mode exactly.
.superpowers/**

# Production builds emit no sourcemaps, but esbuild does not clean the
# directory, so stale ones from a dev build would otherwise be picked up.
**/*.map
**/*.ts
**/*.tsx

*.vsix
.DS_Store
.env

# Scratch files a release run leaves in the working tree. The workflow writes
# its notes to RUNNER_TEMP for this reason, but a local `gh release create
# --notes-file` is an easy way to reintroduce the problem.
release-notes.md