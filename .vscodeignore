# Everything is bundled into dist/ by esbuild, so the extension ships as four
# files plus the icon. Without this, vsce walks node_modules and packages ~6 MB
# of dependencies that are already inlined in the bundle.

node_modules/**

.vscode/**
.claude/**
.github/**

src/**
test/**
fixtures/**
sandbox/**
sandbox-conflict/**
sandbox-multi/**

# Sources and build scripts for the marketplace art. media/icon.png and
# media/screenshot.png ship; what generates them does not.
media/marketplace-icon.svg
media/build-*.mjs

esbuild.mjs
tsconfig.json
package-lock.json
.gitignore
.vscodeignore

# Production builds emit no sourcemaps, but esbuild does not clean the
# directory, so stale ones from a dev build would otherwise be picked up.
**/*.map
**/*.ts
**/*.tsx

*.vsix
.DS_Store
.env